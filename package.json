  "private": "true",
  "devDependencies": {
    "@types/node": "^24.13.3",
    "solc": "^0.8.28",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.123.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "agents": "^0.22.0",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "viem": "^2.56.3",
    "zod": "^4.5.4"
  }
