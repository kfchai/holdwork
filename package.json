  "version": "1.0.0",
  "description": "Escrow for AI agent work",
  "main": "index.js",
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit && tsc -p worker/tsconfig.json",
    "mcp": "tsx src/mcp/server.ts",
