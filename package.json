{
  "name": "holdwork",
  "version": "1.0.0",
  "description": "Escrow for AI agent work",
  "main": "index.js",
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit && npm run worker:types && tsc -p worker/tsconfig.json",
    "mcp": "tsx src/mcp/server.ts",
    "compile:contract": "tsx scripts/compile-contract.ts",
    "smoke": "tsx scripts/smoke-mcp.ts",
    "worker:types": "cd worker && wrangler types",
    "worker:dev": "cd worker && wrangler dev",
    "worker:deploy": "cd worker && wrangler deploy",
    "smoke:remote": "tsx scripts/smoke-remote.ts",
    "live:dispute": "tsx scripts/live-dispute.ts",
    "try:scorer": "tsx scripts/try-scorer.ts",
    "wallet:new": "tsx scripts/new-wallet.ts",
    "moltbook": "tsx scripts/moltbook-post.ts",
    "test:contract": "hardhat test",
    "deploy:escrow": "tsx scripts/deploy-escrow.ts",
    "moltbook:watch": "tsx scripts/moltbook-watch.ts",
    "verifier:bot": "tsx scripts/verifier-bot.ts",
    "testnet:pilot": "tsx scripts/testnet-pilot.ts",
    "worker:deploy:testnet": "cd worker && wrangler deploy -c wrangler.testnet.jsonc",
    "build:site": "tsx scripts/build-site.ts"
  },
  "keywords": [],
  "author": "",
  "license": "Apache-2.0",
  "type": "module",
  "private": "true",
  "devDependencies": {
    "@nomicfoundation/hardhat-toolbox-viem": "^5.0.7",
    "@types/node": "^24.13.3",
    "hardhat": "^3.15.0",
    "solc": "^0.8.28",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7",
    "wrangler": "^4.129.0"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.123.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "agents": "^0.22.0",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "viem": "^2.56.3",
    "zod": "^4.5.4"
  }
}
